if not global.tutorial exit

draw_set_halign(fa_left)

draw_text(96, 1536, "Segure e solte o botao esquerdo do mouse\n para fazer um dash.")
draw_text(608, 1536,"Use o WASD para se movimentar.")
draw_text(160, 1216,"Cada dash que voce faz deixa um buraco\nno lugar que voce estava antes.")
draw_text(640, 1216,"Esse bloco e um buraco,\nnao caia nele.")
draw_text(224, 690,"Cada inimigo possui vida e comportamento diferente\nPara matar um inimigo atravesse ele com um dash,\nSua barra mudara para a cor amarela/azul para indicar que seu dash ira dar dano")
draw_text(20, 160,"Apos pegar esse objeto ele abrira um portal no comeco do mapa, chegue ate o portal para concluir a fase")
draw_text(20, 224,"Cada inimigo fraco que nao foi morto se tornara em sua versao mais forte\nAlem disso, todos os buraco que voce deixou pela fase irao criar fantasmas, voce nao pode mata-los\nSe apresse porque um diluvio ira consumir o mapa quando o portal abrir.")


